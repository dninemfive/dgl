@page "/conway"
@using d9.dgl.conway;
@using d9.aoc.core;
@using Excubo.Blazor.Canvas
@using Excubo.Blazor.Canvas.Contexts

<PageTitle>Conway's Game of Life</PageTitle>

<h1>Conway's Game of Life</h1>

<Canvas @ref="Canvas" width="150px" height="300px" />

<button class="btn btn-primary" @onclick="Evolve">Click me</button>

@code {
    private Canvas Canvas;
    private ConwayGame Game 
        = new(150, 300, 0.1);
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
            await Draw(Game.CurrentState.LiveCells);
    }
    private async Task Evolve()
    {
        await foreach (ConwayState state in Game.Evolve())
            await Draw(state.LiveCells);
    }
    private async Task Draw(IEnumerable<Point<int>> liveCells)
    {
        await using Context2D context = await Canvas.GetContext2DAsync();
        await context.FillStyleAsync("white");
        await context.FillRectAsync(0, 0, Game.Width, Game.Height);
        await context.FillStyleAsync("black");
        foreach ((int x, int y) in liveCells)
            await context.FillRectAsync(x, y, 1, 1);
    }
}
